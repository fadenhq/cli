{
  "name": "@fadenhq/cli",
  "version": "0.4.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Unified social-media publishing for agents and developers: one command/MCP tool posts across X, LinkedIn, Facebook, Instagram, Threads and more.",
  "type": "module",
  "bin": {
    "faden": "./dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadenhq/cli.git",
    "directory": "apps/cli"
  },
  "homepage": "https://faden.io",
  "license": "AGPL-3.0-only",
  "keywords": [
    "social-media",
    "publishing",
    "mcp",
    "agents",
    "x",
    "linkedin",
    "instagram",
    "facebook",
    "threads",
    "cross-posting"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fadenhq/shared": "*",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
